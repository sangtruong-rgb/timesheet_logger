# Personal Pilot Timesheet Logger Environment Configuration
# Copy this file to .env and fill in values as required.
# DO NOT commit real secrets or tokens into version control.

# --- GitHub / GitLab Authentication ---
# Recommended: Use authenticated 'gh' or 'glab' CLI tools on your machine.
# If CLI tools are not installed, provide access tokens below:
GITHUB_TOKEN=
GH_TOKEN=
GITLAB_TOKEN=

# Default Git repository paths to scan for commits (comma-separated, default: ".")
TIMESHEET_REPOS=.

# --- Google Calendar Integration ---
# Path to Google OAuth2 credentials.json (downloaded from Google Cloud Console)
GOOGLE_CALENDAR_CREDENTIALS=config/credentials.json

# Path to cached user authorization token (generated on initial browser OAuth consent)
GOOGLE_CALENDAR_TOKEN=config/token.json

# --- Claude Token Tracking ---
# Directory where Claude Code session transcripts reside (default: ~/.claude)
CLAUDE_DIR=~/.claude
