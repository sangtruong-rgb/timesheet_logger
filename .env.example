# Export variables in your shell; this project does not automatically load .env.
# GitHub only. Secrets must remain in the environment or existing credential helper.
GH_TOKEN=
# CLI --repos > exported TIMESHEET_REPOS > profile repositories.
TIMESHEET_REPOS=owner/repository
# CLI > exported paths > profile paths > repository root defaults.
GOOGLE_CALENDAR_CREDENTIALS=/absolute/path/credentials.json
GOOGLE_CALENDAR_TOKEN=/absolute/path/token.json
# Used by the token collector; collection requires explicit run attribution.
CLAUDE_DIR=~/.claude
