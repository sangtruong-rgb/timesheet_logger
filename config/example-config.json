{
  "author": {
    "names": [
      "Your Name"
    ],
    "emails": [
      "you@example.com"
    ]
  },
  "repositories": [
    "owner/repository"
  ],
  "timezone": "Asia/Ho_Chi_Minh",
  "github": {
    "users": [
      "your-login"
    ],
    "use_git_credentials": false
  },
  "calendar": {
    "provider": "google",
    "calendar_ids": [
      "primary"
    ],
    "token_path": "../token.json",
    "credentials_path": "../credentials.json"
  },
  "block_policy": {
    "strategy": "activity_clusters",
    "inactivity_gap_minutes": 45,
    "minimum_block_minutes": 30,
    "maximum_block_minutes": 90
  },
  "token_tracking": {
    "claude_dir": "~/.claude",
    "csv_path": "../data/token-usage.csv"
  }
}
