#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

usage() {
  cat <<'EOF'
Usage:
  ./bin/personal-timesheet-codex
  ./bin/personal-timesheet-codex 09:00
  ./bin/personal-timesheet-codex "9:00, OT confirmed, attendance confirmed"
  ./bin/personal-timesheet-codex "8:00-12:00, 1h30-4:00"
  ./bin/personal-timesheet-codex "Preview my work for YYYY-MM-DD ..."
  ./bin/personal-timesheet-codex --check

This launcher opens a new Codex session with network and macOS credential-store
access for the personal-timesheet skill. Codex still uses approval policy
on-request. Run it only from this trusted checkout.

A start time or a list of work windows requests today's live-source preview.
A morning start alone uses start-12:00 and 13:30-18:30, with default OT.
Windows such as 8:00-12:00, 1h30-4:00 select 08:00-12:00 and 13:30-16:00.
With no start or windows, the skill asks for the start. Publishing requires an
explicit request.
EOF
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

if ! command -v codex >/dev/null 2>&1; then
  echo "Codex CLI is not available in PATH." >&2
  echo "Start a login shell or add the Codex installation directory to PATH." >&2
  exit 127
fi

if ! codex login status >/dev/null 2>&1; then
  echo "Codex CLI is not logged in. Run: codex login" >&2
  exit 2
fi

if ! command -v gh >/dev/null 2>&1 || ! gh auth status >/dev/null 2>&1; then
  echo "GitHub CLI authentication is unavailable. Run: gh auth login -h github.com" >&2
  exit 2
fi

if [[ ! -x .venv/bin/python ]]; then
  echo "Repository .venv is missing. Create it with Python 3.11+ and install requirements-calendar.txt." >&2
  exit 2
fi

if ! .venv/bin/python -c 'import google.auth, googleapiclient.discovery, google_auth_oauthlib.flow' >/dev/null 2>&1; then
  echo "Google Calendar dependencies are missing from .venv." >&2
  echo "Install requirements-calendar.txt into .venv before retrying." >&2
  exit 2
fi

if [[ "${1:-}" == "--check" ]]; then
  echo "Codex login: OK"
  echo "GitHub authentication: OK"
  echo "Python environment: OK"
  echo "Google Calendar dependencies: OK"
  exit 0
fi

request="${*:-Preview work for today using live GitHub and Google Calendar sources. Do not publish to Gradion. Report actual Codex token usage; if no AI block is eligible, report SKIPPED instead of inventing zero usage.}"

# Live GitHub access needs the macOS credential store, and both live providers
# need outbound network access. A normal workspace-write Codex sandbox hides
# those capabilities even though the credentials remain valid on the host.
exec codex \
  --cd "$root" \
  --sandbox danger-full-access \
  --ask-for-approval on-request \
  --config model_reasoning_effort=low \
  "\$personal-timesheet Use English for all communication with me, including questions, progress updates and reports. $request"
